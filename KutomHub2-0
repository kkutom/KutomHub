local function updateEspForCharacter(char, enable)
    if not char then return end
    local hl = char:FindFirstChild("KutomHubESP")
    if enable then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "KutomHubESP"
            hl.FillColor = Color3.fromRGB(0, 170, 255)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.Adornee = char
            hl.Parent = char
        end
    else
        if hl then
            hl:Destroy()
        end
    end
end

createToggleRow("ESP (Wallhack)", 350, function(state)
    espEnabled = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if espEnabled then
                if p.Character then updateEspForCharacter(p.Character, true) end
                p.CharacterAdded:Connect(function(newChar)
                    if espEnabled then
                        newChar:WaitForChild("HumanoidRootPart", 5)
                        updateEspForCharacter(newChar, true)
                    end
                end)
            else
                if p.Character then updateEspForCharacter(p.Character, false) end
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
    if p ~= player then
        p.CharacterAdded:Connect(function(newChar)
