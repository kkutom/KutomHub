local function runHDSequence(commands, notifTitle, notifMsg, delaySec)
    local waitDelay = delaySec or 0.5
    task.spawn(function()
        pcall(function()
            local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
            if sigs then sigs = sigs:FindFirstChild("Signals") end
            if sigs then
                local req = sigs:FindFirstChild("RequestCommandSilent")
                if req and req:IsA("RemoteFunction") then
                    for i, cmd in ipairs(commands) do
                        req:InvokeServer(cmd)
                        if i < #commands then
                            task.wait(waitDelay)
                        end
                    end
                    if notifMsg then
                        showHDHint(notifMsg, Color3.fromRGB(85, 255, 85))
                    end
                end
            end
        end)
    end)
end

