            end,
            addImageButton = function(text, image, desc, callback)
                if localScript:FindFirstChild("imageButton") then
                    local b = localScript.imageButton:Clone()
                    b.Parent = pg
                    b.TextLabel.Text = text
                    if image and image ~= "" then
                        b.ImageLabel.Visible = true
                        task.spawn(function()
                            local resolved = getCustomImage(image)
                            pcall(function()
                                b.ImageLabel.Image = resolved
                            end)
                        end)
                    else
                        b.ImageLabel.Visible = false
                        b.TextLabel.Position = UDim2.new(0.05, 0, 0.5, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    end
                    if desc and desc ~= "" and b:FindFirstChild("desc") then
                        b.desc.Text = desc
                        b.desc.Visible = true
                        b.TextLabel.Position = UDim2.new(image and 0.155 or 0.05, 0, 0.39, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    else
                        if b:FindFirstChild("desc") then
                            b.desc:Destroy()
                        end
                        b.TextLabel.Position = UDim2.new(image and 0.155 or 0.05, 0, 0.5, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    end
                    b.MouseButton1Click:Connect(callback)
                    return b
                else
                    local b = localScript.button:Clone()
                    b.Parent = pg
                    b.TextLabel.Text = text
                    b.MouseButton1Click:Connect(callback)
                    return b
                end
            end,
            addToggle = function(text, defaultState, callbackOn, callbackOff, settingKey)
                local key = settingKey or text
                local state = defaultState
                if savedSettings[key] ~= nil then
                    state = savedSettings[key]
                end

                local tog = localScript.toggle:Clone()
                tog.Parent = pg
                tog.TextLabel.Text = text
                tog:SetAttribute("enable", state)
                tog.status.Text = state and "Вкл." or "Выкл."
                tog.status.TextColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

                local function applyState(nxt)
                    tog:SetAttribute("enable", nxt)
                    tog.status.Text = nxt and "Вкл." or "Выкл."
                    tog.status.TextColor3 = nxt and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                    savedSettings[key] = nxt
                    saveSettings()
                    if nxt then
                        if callbackOn then callbackOn() end
                    else
                        if callbackOff then callbackOff() end
                    end
                end

                tog.MouseButton1Click:Connect(function()
                    local cur = tog:GetAttribute("enable") == true
                    applyState(not cur)
                end)

                -- Автоматическое включение при входе, если было сохранено состояние true
                if state == true then
                    task.spawn(function()
                        task.wait(1.5)
                        if callbackOn then
                            pcall(callbackOn)
                        end
                    end)
                end

                return tog
            end,
