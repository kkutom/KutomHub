    local function applyLocalMorph(path, morphName)
        local getAsset = (typeof(getcustomasset) == "function" and getcustomasset)
            or (typeof(getsynasset) == "function" and getsynasset)
        if not getAsset or typeof(isfile) ~= "function" or not isfile(path) then
            showNotification("Local морфы", "Поместите " .. path .. " в workspace исполнителя; нужен getcustomasset", true)
            return
        end
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            showNotification("Local морфы", "Персонаж ещё не загружен", true)
            return
        end
        local ok, objects = pcall(function()
            return game:GetObjects(getAsset(path))
        end)
        if not ok or type(objects) ~= "table" or not objects[1] then
            showNotification("Local морфы", "Не удалось загрузить rbxm. Проверьте поддержку GetObjects и getcustomasset", true)
            return
        end
        local container = Instance.new("Model")
        container.Name = "BarboskinLocalMorph"
        for _, object in ipairs(objects) do object.Parent = container end
        local source = container
        local humanoid = container:FindFirstChildWhichIsA("Humanoid", true)
        if humanoid and humanoid.Parent:IsA("Model") then source = humanoid.Parent end
        local names = {"Head", "Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
        local bases = {}
        for _, name in ipairs(names) do
            local from = source:FindFirstChild(name)
            local to = character:FindFirstChild(name)
            if from and from:IsA("BasePart") and to and to:IsA("BasePart") then
                table.insert(bases, {from = from, to = to, cframe = from.CFrame})
            end
        end
        if #bases == 0 then
            container:Destroy()
            showNotification("Local морфы", "Не найдены совпадающие части тела. Нужна структура морфа и персонажа", true)
            return
        end
        -- Сохраняем связи до удаления суставов: они точнее расстояния между деталями.
        -- Поиск прекращается на первой части тела, поэтому через Torso нельзя
        -- случайно перейти с руки на ногу.
        local links, baseByPart = {}, {}
        for _, base in ipairs(bases) do baseByPart[base.from] = base end
        local function link(a, b)
            if not a or not b or not a:IsA("BasePart") or not b:IsA("BasePart") then return end
            links[a] = links[a] or {}
            links[b] = links[b] or {}
            table.insert(links[a], b)
            table.insert(links[b], a)
        end
        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("JointInstance") or item:IsA("WeldConstraint") then
                link(item.Part0, item.Part1)
            end
        end
        local function findConnectedBase(part)
            local queue, visited, index = {part}, {[part] = true}, 1
            while index <= #queue do
                local current = queue[index]
                index = index + 1
                if baseByPart[current] then return baseByPart[current] end
                for _, neighbor in ipairs(links[current] or {}) do
                    if not visited[neighbor] then
                        visited[neighbor] = true
                        table.insert(queue, neighbor)
                    end
                end
            end
        end
        -- Для Экскурсовода сохраняем расстояния между частями из файла.
        -- Движение берём как изменение позы текущего рига относительно начальной.
        local sourceRoot = source:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        local useOriginalRig = path == "Morphs/eksursovod.rbxm"
            and sourceRoot and sourceRoot:IsA("BasePart") and targetRoot
        if useOriginalRig then
            for _, base in ipairs(bases) do
                base.rest = sourceRoot.CFrame:ToObjectSpace(base.cframe)
                base.initial = targetRoot.CFrame:ToObjectSpace(base.to.CFrame)
            end
        end
        local parts = {}
        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then
                local closest = baseByPart[item]
                -- У Дружка обе маленькие руки называются mesh_id307.
                -- Выбираем только среди частей рук, а не среди ног или туловища.
                local parentModel = item:FindFirstAncestor("Дружок")
                if item:IsA("MeshPart") and item.Name == "mesh_id307" and parentModel then
                    local armDistance
                    for _, base in ipairs(bases) do
                        local name = base.from.Name
                        if name == "Left Arm" or name == "Right Arm"
                            or name:find("Arm") or name == "LeftHand" or name == "RightHand" then
                            local d = (item.Position - base.cframe.Position).Magnitude
                            if not armDistance or d < armDistance then
                                closest, armDistance = base, d
                            end
                        end
                    end
                end
                -- Эти детали Экскурсовода относятся к туловищу, а не к ногам.
                if path == "Morphs/eksursovod.rbxm" and (item.Name == "mesh_id692" or item.Name == "mesh_id693") then
                    for _, base in ipairs(bases) do
                        if base.from.Name == "Torso" or base.from.Name == "LowerTorso" then
                            closest = base
                            break
                        end
                    end
                end
                -- Нижняя часть Дружка Леди должна двигаться вместе с туловищем.
                if path == "Morphs/drujokledi.rbxm" and item.Name == "Handle"
                    and item.Parent and item.Parent.Name == "Дружок" then
                    for _, base in ipairs(bases) do
                        if base.from.Name == "Torso" or base.from.Name == "LowerTorso" then
                            closest = base
                            break
                        end
                    end
                end
                local ancestor = item.Parent
                while not closest and ancestor and ancestor ~= container do
                    closest = baseByPart[ancestor]
                    ancestor = ancestor.Parent
                end
                closest = closest or findConnectedBase(item)
                if not closest then
                    local distance
                    for _, base in ipairs(bases) do
                        local d = (item.Position - base.cframe.Position).Magnitude
                        if not distance or d < distance then closest, distance = base, d end
                    end
                end
                table.insert(parts, {part = item, target = closest.to, base = closest, offset = closest.cframe:ToObjectSpace(item.CFrame)})
            end
        end
        if #parts == 0 then
            container:Destroy()
            showNotification("Local морфы", "В файле не найдены видимые части", true)
            return
        end
        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("BaseScript") or item:IsA("ModuleScript") or item:IsA("JointInstance") or item:IsA("Constraint") or item:IsA("Humanoid") or item:IsA("GuiBase2d") or item:IsA("SurfaceGui") or item:IsA("BillboardGui") then
                item:Destroy()
            elseif item:IsA("BasePart") then
                if item.Name == "HumanoidRootPart" then
                    item:Destroy()
                else
                    item.Anchored = true
                    item.CanCollide = false
                    item.CanTouch = false
                    item.CanQuery = false
                end
            end
        end
        removeLocalMorph()
        local hidden, connections = {}, {}
        local function hide(item)
            if item:IsA("BasePart") then
                hidden[item] = item.LocalTransparencyModifier
                item.LocalTransparencyModifier = 1
            elseif item:IsA("Decal") then
                hidden[item] = item.Transparency
                item.Transparency = 1
            end
        end
        for _, item in ipairs(character:GetDescendants()) do hide(item) end
        table.insert(connections, character.DescendantAdded:Connect(hide))
        container.Parent = Workspace
        local active = true
        local function cleanup()
            if not active then return end
            active = false
            for _, connection in ipairs(connections) do connection:Disconnect() end
            container:Destroy()
            for item, value in pairs(hidden) do
                if item.Parent then
                    if item:IsA("BasePart") then item.LocalTransparencyModifier = value
                    elseif item:IsA("Decal") then item.Transparency = value end
                end
            end
            if _G.BarboskinRemoveLocalMorph == cleanup then _G.BarboskinRemoveLocalMorph = nil end
        end
        _G.BarboskinRemoveLocalMorph = cleanup
        table.insert(connections, player.CharacterAdded:Connect(cleanup))
        table.insert(connections, RunService.RenderStepped:Connect(function()
            if player.Character ~= character or not character.Parent then cleanup(); return end
            for _, entry in ipairs(parts) do
                if entry.part.Parent and entry.target.Parent then
                    if useOriginalRig and targetRoot.Parent then
                        local current = targetRoot.CFrame:ToObjectSpace(entry.target.CFrame)
                        local movement = entry.base.initial:Inverse() * current
                        entry.part.CFrame = targetRoot.CFrame * CFrame.new(0, -0.3, 0) * entry.base.rest * movement * entry.offset
                    else
                        entry.part.CFrame = entry.target.CFrame * entry.offset
                    end
                end
            end
        end))
        showNotification("Local морфы", morphName .. " надет локально", false)
    end
    -- Эксперимент: сохраняем суставы и детали исходной модели.
    local function applyRigTest(path)
        local getAsset = (typeof(getcustomasset) == "function" and getcustomasset)
            or (typeof(getsynasset) == "function" and getsynasset)
        local character = player.Character
        local realRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not getAsset or typeof(isfile) ~= "function" or not isfile(path) then
            showNotification("Local морфы", "Не найден файл " .. path .. " или getcustomasset", true)
            return
        end
        if not realRoot then
            showNotification("Local морфы", "Персонаж ещё не загружен", true)
            return
        end
        local ok, objects = pcall(function() return game:GetObjects(getAsset(path)) end)
        if not ok or type(objects) ~= "table" or not objects[1] then
            showNotification("Local морфы", "Не удалось загрузить файл морфа", true)
            return
        end
        local container = Instance.new("Model")
        container.Name = "BarboskinLocalMorph"
        for _, object in ipairs(objects) do object.Parent = container end
        local humanoid = container:FindFirstChildWhichIsA("Humanoid", true)
        local rig = humanoid and humanoid.Parent
        local root = rig and rig:FindFirstChild("HumanoidRootPart")
        if not rig or not rig:IsA("Model") or not root or not root:IsA("BasePart") then
            container:Destroy()
            showNotification("Local морфы", "В файле не найден риг с HumanoidRootPart", true)
            return
        end
        local motors = {}
        for _, motor in ipairs(rig:GetDescendants()) do
            if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
                for _, other in ipairs(character:GetDescendants()) do
                    if other:IsA("Motor6D") and other.Name == motor.Name and other.Part0 and other.Part1
                        and other.Part0.Name == motor.Part0.Name and other.Part1.Name == motor.Part1.Name then
                        table.insert(motors, {copy = motor, original = other})
                        break
                    end
                end
            end
        end
        if #motors == 0 then
            container:Destroy()
            showNotification("Local морфы", "Не найдены совпадающие суставы: проверьте риг персонажа", true)
            return
        end
        -- Берём фактическую позу частей, а не только Motor6D.Transform:
        -- некоторые анимации управляют суставами через C0/C1.
        local trackedParts = {}
        for _, name in ipairs({"Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
            "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand",
            "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg",
            "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
            local copyPart = rig:FindFirstChild(name)
            local realPart = character:FindFirstChild(name)
            if copyPart and copyPart:IsA("BasePart") and realPart and realPart:IsA("BasePart") then
                table.insert(trackedParts, {
                    copy = copyPart, original = realPart,
                    rest = root.CFrame:ToObjectSpace(copyPart.CFrame),
                    initial = realRoot.CFrame:ToObjectSpace(realPart.CFrame)
                })
            end
        end
        -- Все детали закреплены: положение вычисляем по сохранённым соединениям.
        local graph, fallback = {}, {}
        local motorMap = {}
        for _, pair in ipairs(motors) do motorMap[pair.copy] = pair.original end
        local function connectParts(a, b, relative, original)
            if not a or not b then return end
            graph[a] = graph[a] or {}
            graph[b] = graph[b] or {}
            local initial = original and original.Transform
            table.insert(graph[a], {part = b, relative = relative, motor = original, initial = initial})
            table.insert(graph[b], {part = a, relative = relative, motor = original, initial = initial, reverse = true})
        end
        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("BasePart") then
                fallback[item] = root.CFrame:ToObjectSpace(item.CFrame)
            elseif item:IsA("JointInstance") or item:IsA("WeldConstraint") then
                local a, b = item.Part0, item.Part1
                if a and b then connectParts(a, b, a.CFrame:ToObjectSpace(b.CFrame), motorMap[item]) end
            end
        end
        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("BaseScript") or item:IsA("ModuleScript") or item:IsA("Humanoid")
                or item:IsA("JointInstance") or item:IsA("Constraint")
                or item:IsA("GuiBase2d") or item:IsA("SurfaceGui") or item:IsA("BillboardGui") then
                item:Destroy()
            elseif item:IsA("BasePart") then
                item.Anchored = true
                item.CanCollide = false
                item.CanTouch = false
                item.CanQuery = false
                item.Massless = true
            end
        end
        removeLocalMorph()
        local hidden, connections = {}, {}
        local function hide(item)
            if item:IsA("BasePart") then
                hidden[item] = item.LocalTransparencyModifier
                item.LocalTransparencyModifier = 1
            elseif item:IsA("Decal") then
                hidden[item] = item.Transparency
                item.Transparency = 1
            end
        end
        for _, item in ipairs(character:GetDescendants()) do hide(item) end
        table.insert(connections, character.DescendantAdded:Connect(hide))
        local active = true
        local function cleanup()
            if not active then return end
            active = false
            for _, connection in ipairs(connections) do connection:Disconnect() end
            container:Destroy()
            for item, value in pairs(hidden) do
                if item.Parent then
                    if item:IsA("BasePart") then item.LocalTransparencyModifier = value
                    elseif item:IsA("Decal") then item.Transparency = value end
                end
            end
            if _G.BarboskinRemoveLocalMorph == cleanup then _G.BarboskinRemoveLocalMorph = nil end
        end
        _G.BarboskinRemoveLocalMorph = cleanup
        rig:PivotTo(realRoot.CFrame * root.CFrame:ToObjectSpace(rig:GetPivot()))
        container.Parent = Workspace
        table.insert(connections, player.CharacterAdded:Connect(cleanup))
        table.insert(connections, RunService.RenderStepped:Connect(function()
            if player.Character ~= character or not character.Parent or not realRoot.Parent then cleanup(); return end
            local morphRootFrame = realRoot.CFrame * CFrame.new(0, -1.25, 0)
            local frames, queue, index = {[root] = morphRootFrame}, {root}, 1
            for _, tracked in ipairs(trackedParts) do
                if tracked.copy.Parent and tracked.original.Parent then
                    local current = realRoot.CFrame:ToObjectSpace(tracked.original.CFrame)
                    local change = tracked.initial:Inverse() * current
                    frames[tracked.copy] = morphRootFrame * tracked.rest * change
                    table.insert(queue, tracked.copy)
                end
            end
            while index <= #queue do
                local part = queue[index]
                index = index + 1
                for _, edge in ipairs(graph[part] or {}) do
                    if not frames[edge.part] then
                        local relative = edge.relative
                        if edge.motor and edge.motor.Parent then
                            relative = relative * edge.initial:Inverse() * edge.motor.Transform
                        end
                        if edge.reverse then relative = relative:Inverse() end
                        frames[edge.part] = frames[part] * relative
                        table.insert(queue, edge.part)
                    end
                end
            end
            for part, offset in pairs(fallback) do
                if part.Parent then part.CFrame = frames[part] or (morphRootFrame * offset) end
            end
        end))
        showNotification("Local морфы", "Экскурсовод: тест копии рига", false)
    end
