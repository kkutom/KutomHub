-- Kutom Coin Collector GUI (Classic Vibe - Pull Only)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Удаляем старую версию, если она была
if PlayerGui:FindFirstChild("KutomCoinGUI") then
	PlayerGui.KutomCoinGUI:Destroy()
end

-- Создаем ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KutomCoinGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = PlayerGui

-- Главное окно в стиле старого Roblox
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 300, 0, 160)
MainFrame.Position = UDim2.new(0.5, -150, 0.5, -80)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

-- Шапка (классический синий градиент / плашка)
local Header = Instance.new("Frame")
Header.Size = UDim2.new(1, 0, 0, 32)
Header.BackgroundColor3 = Color3.fromRGB(0, 102, 204)
Header.BorderSizePixel = 0
Header.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -40, 1, 0)
Title.Position = UDim2.new(0, 8, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "KUTOM COIN PULLER"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 14
Title.Font = Enum.Font.SourceSansBold
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = Header

-- Кнопка закрытия (Х) в стиле старого окна
local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 26, 0, 24)
CloseBtn.Position = UDim2.new(1, -29, 0.5, -12)
CloseBtn.BackgroundColor3 = Color3.fromRGB(204, 0, 0)
CloseBtn.BorderColor3 = Color3.fromRGB(100, 0, 0)
CloseBtn.BorderSizePixel = 1
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 14
CloseBtn.Font = Enum.Font.SourceSansBold
CloseBtn.Text = "X"
CloseBtn.Parent = Header

CloseBtn.MouseButton1Click:Connect(function()
	ScreenGui:Destroy()
end)

-- Контейнер для элементов
local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, -16, 1, -48)
Container.Position = UDim2.new(0, 8, 0, 40)
Container.BackgroundTransparency = 1
Container.Parent = MainFrame

local Layout = Instance.new("UIListLayout")
Layout.Padding = UDim.new(0, 8)
Layout.SortOrder = Enum.SortOrder.LayoutOrder
Layout.Parent = Container

-- Функция отключения коллизий у монеты
local function disableCollisions(coin)
	if coin:IsA("BasePart") then
		coin.CanCollide = false
	end
end

-- Кнопка сбора (притянуть все монеты к себе)
local PullOnceBtn = Instance.new("TextButton")
PullOnceBtn.Size = UDim2.new(1, 0, 0, 36)
PullOnceBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
PullOnceBtn.BorderColor3 = Color3.fromRGB(20, 20, 20)
PullOnceBtn.BorderSizePixel = 1
PullOnceBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
PullOnceBtn.TextSize = 14
PullOnceBtn.Font = Enum.Font.SourceSansBold
PullOnceBtn.Text = "Собрать все монеты (к себе)"
PullOnceBtn.LayoutOrder = 1
PullOnceBtn.Parent = Container

-- Статус текст
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 28)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "Статус: Готово к сбору"
StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
StatusLabel.TextSize = 13
StatusLabel.Font = Enum.Font.SourceSans
StatusLabel.LayoutOrder = 2
StatusLabel.Parent = Container

-- Логика сбора
PullOnceBtn.MouseButton1Click:Connect(function()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local rootPart = char.HumanoidRootPart
		local coinsFolder = Workspace:FindFirstChild("Манеты")
		
		if coinsFolder then
			local count = 0
			for _, coin in ipairs(coinsFolder:GetChildren()) do
				if coin:IsA("BasePart") then
					disableCollisions(coin)
					coin.CFrame = rootPart.CFrame
					count = count + 1
				end
			end
			StatusLabel.Text = "Статус: Притянуто монет: " .. count
		else
			StatusLabel.Text = "Статус: Папка 'Манеты' не найдена!"
		end
	else
		StatusLabel.Text = "Статус: Персонаж не найден!"
	end
end)
