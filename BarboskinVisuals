local springEnabled = false
local springOriginals = {}
local springConnection
local function restoreSpring()
    for mesh, original in pairs(springOriginals) do
        pcall(function()
            if mesh.Parent then mesh.TextureId = original.texture end
            if original.handle.Parent then original.handle.Color = original.color end
        end)
    end
    springOriginals = {}
end
local function setRainbowSpring(enabled)
    springEnabled = enabled
    if springConnection then springConnection:Disconnect(); springConnection = nil end
    if not enabled then restoreSpring(); return end
    local elapsed = 0
    springConnection = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        if elapsed < 0.05 then return end
        elapsed = 0
        local hue = (math.floor(os.clock() * 2) % 12) / 12
        local backpack = player:FindFirstChildOfClass("Backpack")
        for _, holder in pairs({backpack, player.Character}) do
            if holder then
                local tool = holder:FindFirstChild("Очень Крутое")
                local handle = tool and tool:IsA("Tool") and tool:FindFirstChild("Handle")
                local mesh = handle and handle:IsA("BasePart") and handle:FindFirstChild("Mesh")
                if mesh and mesh:IsA("SpecialMesh") then
                    if not springOriginals[mesh] then
                        springOriginals[mesh] = {texture = mesh.TextureId, color = handle.Color, handle = handle}
                    end
                    mesh.TextureId = ""
                    handle.Color = Color3.fromHSV(hue, 1, 1)
                end
            end
        end
    end)
end
_G.BarboskinRainbowSpringCleanup = function() setRainbowSpring(false) end

