                ";head me 15093053680",
                ";hat me 1402433072"
            }, "Скинсеты", "✅ Белый сет надет!", 0.5)
        end)

    local function openCustomSkinsets()
        local old = playerGui:FindFirstChild("BarboskinCustomSkinsets")
        if old then old:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "BarboskinCustomSkinsets"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 1001
        gui.Parent = playerGui
        local panel = Instance.new("Frame")
        panel.AnchorPoint = Vector2.new(0.5, 0.5)
        panel.Position = UDim2.fromScale(0.5, 0.5)
        panel.Size = UDim2.fromScale(0.92, 0.86)
        panel.BackgroundColor3 = Color3.fromRGB(28, 31, 43)
        panel.BorderSizePixel = 0
        panel.Parent = gui
        local constraint = Instance.new("UISizeConstraint")
        constraint.MaxSize = Vector2.new(700, 600)
        constraint.Parent = panel
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = panel
        local function makeButton(parent, text, pos, size)
            local b = Instance.new("TextButton")
            b.Position, b.Size = pos, size
            b.BackgroundColor3 = Color3.fromRGB(64, 70, 91)
            b.BorderSizePixel = 0
            b.Font = Enum.Font.GothamBold
            b.TextColor3 = Color3.new(1, 1, 1)
            b.TextSize = 15
            b.TextWrapped = true
            b.Text = text
            b.Parent = parent
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 7)
            c.Parent = b
            return b
        end
        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Position = UDim2.fromOffset(16, 7)
        title.Size = UDim2.new(1, -75, 0, 38)
        title.Font = Enum.Font.GothamBold
        title.Text = "Мои скинсеты"
        title.TextColor3 = Color3.new(1, 1, 1)
        title.TextSize = 20
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = panel
        makeButton(panel, "✕", UDim2.new(1, -48, 0, 8), UDim2.fromOffset(36, 34)).MouseButton1Click:Connect(function() gui:Destroy() end)
        local list = Instance.new("ScrollingFrame")
        list.Position = UDim2.fromOffset(16, 54)
        list.Size = UDim2.new(1, -32, 1, -120)
        list.BackgroundTransparency = 1
        list.BorderSizePixel = 0
        list.ScrollBarThickness = 5
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.CanvasSize = UDim2.new()
        list.Parent = panel
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 7)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = list
        local render
        local function codeWindow(set)
            local old = panel:FindFirstChild("ShareCode")
            if old then old:Destroy() end
            local overlay = Instance.new("Frame")
            overlay.Name = "ShareCode"
            overlay.Size = UDim2.fromScale(1, 1)
            overlay.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
            overlay.BackgroundTransparency = 0.05
            overlay.BorderSizePixel = 0
            overlay.ZIndex = 10
            overlay.Parent = panel
            local title = Instance.new("TextLabel")
            title.Position = UDim2.new(0.06, 0, 0.18, 0)
            title.Size = UDim2.new(0.88, 0, 0.15, 0)
            title.BackgroundTransparency = 1
            title.Font = Enum.Font.GothamBold
            title.Text = set and "Код скинсета" or "Импортировать скинсет"
            title.TextColor3 = Color3.new(1, 1, 1)
            title.TextSize = 18
            title.TextWrapped = true
            title.ZIndex = 11
            title.Parent = overlay
            local input = Instance.new("TextBox")
            input.Position = UDim2.new(0.06, 0, 0.36, 0)
            input.Size = UDim2.new(0.88, 0, 0.17, 0)
            input.BackgroundColor3 = Color3.fromRGB(45,49,65)
            input.TextColor3 = Color3.new(1,1,1)
            input.TextSize = 15
            input.Font = Enum.Font.Gotham
            input.TextWrapped = true
            input.ClearTextOnFocus = false
            input.PlaceholderText = "Вставьте код скинсета"
            input.Text = set and (encodeSkinset(set) or "") or ""
            input.TextEditable = not set
            input.ZIndex = 11
            input.Parent = overlay
            local feedback = Instance.new("TextLabel")
            feedback.Position = UDim2.new(0.06,0,0.54,0)
            feedback.Size = UDim2.new(0.88,0,0.1,0)
            feedback.BackgroundTransparency = 1
            feedback.TextColor3 = Color3.fromRGB(220,220,230)
            feedback.Font = Enum.Font.Gotham
            feedback.TextSize = 13
            feedback.TextWrapped = true
            feedback.Text = set and (input.Text == "" and "Не удалось создать код" or "Код можно скопировать и отправить другу") or ""
            feedback.ZIndex = 11
            feedback.Parent = overlay
            local close = makeButton(overlay,"Закрыть",UDim2.new(0.06,0,0.68,0),UDim2.new(0.42,0,0,42))
            local action = makeButton(overlay,set and "Скопировать" or "Импортировать",UDim2.new(0.52,0,0.68,0),UDim2.new(0.42,0,0,42))
            close.ZIndex, action.ZIndex = 11, 11
            close.MouseButton1Click:Connect(function() overlay:Destroy() end)
            action.MouseButton1Click:Connect(function()
                if set then
                    if input.Text == "" then return end
                    if typeof(setclipboard) ~= "function" then feedback.Text = "Буфер обмена недоступен: выделите код вручную"; input.TextEditable = true; return end
                    local ok = pcall(setclipboard, input.Text)
                    feedback.Text = ok and "Код скопирован" or "Не удалось скопировать код"
                else
                    local decoded = decodeSkinset(input.Text)
                    if not decoded then feedback.Text = "Неверный или повреждённый код"; return end
                    local updated = table.clone(customSkinsets)
                    table.insert(updated, decoded)
                    if not saveCustomSkinsets(updated) then feedback.Text = "Не удалось сохранить скинсет"; return end
                    customSkinsets = updated
                    overlay:Destroy()
                    render()
                end
            end)
        end
        local importButton = makeButton(panel, "Импортировать скинсет", UDim2.new(0,16,1,-53), UDim2.new(1,-32,0,40))
        importButton.MouseButton1Click:Connect(function() codeWindow(nil) end)
        render = function()
            for _, child in ipairs(list:GetChildren()) do if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end end
            if #customSkinsets == 0 then
                local empty = Instance.new("TextLabel")
                empty.BackgroundTransparency = 1
                empty.Size = UDim2.new(1, -5, 0, 70)
                empty.Font = Enum.Font.Gotham
                empty.TextColor3 = Color3.fromRGB(190, 195, 210)
                empty.TextWrapped = true
                empty.Text = "Пока нет скинсетов. Создайте их из корзины в каталоге."
                empty.Parent = list
            end
            for index, set in ipairs(customSkinsets) do
                if type(set) == "table" and type(set.name) == "string" and type(set.items) == "table" then
                    local row = Instance.new("Frame")
                    row.Size = UDim2.new(1, -6, 0, 100)
                    row.BackgroundTransparency = 1
                    row.LayoutOrder = index
                    row.Parent = list
                    local apply = makeButton(row, "👕 " .. set.name, UDim2.new(), UDim2.new(1, 0, 0, 45))
                    apply.MouseButton1Click:Connect(function()
                        local commands = {";clrhats"}
                        for _, item in ipairs(set.items) do
                            local id = tostring(item.id or "")
                            if id:match("^%d+$") then
                                local prefix = (item.kind == "head" and ";head me ") or (item.kind == "shirt" and ";shirt me ") or (item.kind == "pants" and ";pants me ") or ";hat me "
                                table.insert(commands, prefix .. id)
                            end
                        end
                        runHDSequence(commands, "Скинсеты", "Команды скинсета отправлены", 0.5)
                    end)
                    local edit = makeButton(row, "Изменить", UDim2.new(0, 0, 0, 50), UDim2.new(0.32, 0, 0, 45))
                    local share = makeButton(row, "Поделиться", UDim2.new(0.34, 0, 0, 50), UDim2.new(0.32, 0, 0, 45))
                    share.MouseButton1Click:Connect(function() codeWindow(set) end)
                    edit.BackgroundColor3 = Color3.fromRGB(65, 105, 150)
                    edit.MouseButton1Click:Connect(function() openAccessoryCatalog(index) end)
                    local remove = makeButton(row, "Удалить", UDim2.new(0.68, 0, 0, 50), UDim2.new(0.32, 0, 0, 45))
                    remove.BackgroundColor3 = Color3.fromRGB(145, 55, 62)
                    remove.MouseButton1Click:Connect(function()
                        local oldConfirm = panel:FindFirstChild("ConfirmDelete")
                        if oldConfirm then oldConfirm:Destroy() end
                        local overlay = Instance.new("Frame")
                        overlay.Name = "ConfirmDelete"
                        overlay.Size = UDim2.fromScale(1, 1)
                        overlay.BackgroundColor3 = Color3.fromRGB(12, 14, 21)
                        overlay.BackgroundTransparency = 0.15
                        overlay.BorderSizePixel = 0
                        overlay.ZIndex = 10
                        overlay.Parent = panel
                        local message = Instance.new("TextLabel")
                        message.AnchorPoint = Vector2.new(0.5, 0.5)
                        message.Position = UDim2.fromScale(0.5, 0.42)
                        message.Size = UDim2.new(1, -40, 0, 80)
                        message.BackgroundTransparency = 1
                        message.Font = Enum.Font.GothamBold
                        message.Text = "Удалить скинсет «" .. set.name .. "»?"
                        message.TextColor3 = Color3.new(1, 1, 1)
                        message.TextSize = 19
                        message.TextWrapped = true
                        message.ZIndex = 11
                        message.Parent = overlay
                        local cancel = makeButton(overlay, "Отмена", UDim2.new(0.1, 0, 0.55, 0), UDim2.new(0.38, 0, 0, 44))
                        local confirm = makeButton(overlay, "Удалить", UDim2.new(0.52, 0, 0.55, 0), UDim2.new(0.38, 0, 0, 44))
                        cancel.ZIndex, confirm.ZIndex = 11, 11
                        confirm.BackgroundColor3 = Color3.fromRGB(160, 55, 62)
                        cancel.MouseButton1Click:Connect(function() overlay:Destroy() end)
                        confirm.MouseButton1Click:Connect(function()
                            local currentIndex = table.find(customSkinsets, set)
                            if not currentIndex then overlay:Destroy(); render(); return end
                            local updated = table.clone(customSkinsets)
                            table.remove(updated, currentIndex)
                            if not saveCustomSkinsets(updated) then
                                overlay:Destroy()
                                showNotification("Скинсеты", "Не удалось сохранить изменения", true)
                                return
                            end
                            customSkinsets = updated
                            overlay:Destroy()
                            render()
                        end)
                    end)
                end
            end
        end
        refreshCustomSkinsets = function()
            if gui.Parent then render() end
        end
        gui.Destroying:Connect(function() refreshCustomSkinsets = nil end)
        render()
    end


    -- Одна кнопка Topbar открывает выбор нужного раздела.
    pcall(function()
        local module = ReplicatedStorage:WaitForChild("Icon", 5)
        if not module then return end
        local Icon = require(module)
        if _G.BarboskinTopbarIcons then
            for _, oldIcon in pairs(_G.BarboskinTopbarIcons) do pcall(function() oldIcon:destroy() end) end
        end
        local icon = Icon.new()
            :setName("BarboskinVisuals")
            :setImage(6031094678)
            :setLabel("Поиск Аксессуаров")
            :setCaption("BarboskinVisuals")
            :oneClick()
        _G.BarboskinTopbarIcons = {icon}
        icon:bindEvent("selected", function()
            local old = playerGui:FindFirstChild("BarboskinTopbarMenu")
            if old then old:Destroy(); return end
            local menu = Instance.new("ScreenGui")
            menu.Name = "BarboskinTopbarMenu"
            menu.ResetOnSpawn = false
            menu.DisplayOrder = 1002
            menu.Parent = playerGui
            local frame = Instance.new("Frame")
            frame.AnchorPoint = Vector2.new(0.5, 0)
            frame.Position = UDim2.new(0.5, 0, 0, 8)
            frame.Size = UDim2.new(0, 240, 0, 140)
            frame.BackgroundColor3 = Color3.fromRGB(28, 31, 43)
            frame.BorderSizePixel = 0
            frame.Parent = menu
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 10)
            corner.Parent = frame
            local function option(text, y, callback)
                local button = Instance.new("TextButton")
                button.Position = UDim2.new(0, 10, 0, y)
                button.Size = UDim2.new(1, -20, 0, 38)
                button.BackgroundColor3 = Color3.fromRGB(64, 70, 91)
                button.BorderSizePixel = 0
                button.Font = Enum.Font.GothamBold
                button.Text = text
                button.TextSize = 14
                button.TextColor3 = Color3.new(1, 1, 1)
                button.Parent = frame
                local round = Instance.new("UICorner")
                round.CornerRadius = UDim.new(0, 7)
                round.Parent = button
                button.MouseButton1Click:Connect(function() menu:Destroy(); callback() end)
            end
            option("Поиск аксессуаров", 8, openAccessoryCatalog)
            option("Мои скинсеты", 51, openCustomSkinsets)
            option("Закрыть", 94, function() end)
        end)
    end)
    return true
end

