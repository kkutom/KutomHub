                else 
                    if playAnim then playAnim(id) end
                end 
                break
            end
        end
    end
end)

local function CreateToggleWithBind(page, text, bindId, initialState, callback, layoutOrder)
    if not mySetts.toggles then mySetts.toggles = {} end
    
    local enabled = mySetts.toggles[text]
    if enabled == nil then
        enabled = initialState or false
        mySetts.toggles[text] = enabled
    end

    local Row = make("Frame", {Size = UDim2.new(1, -10, 0, 34), BackgroundTransparency = 1, LayoutOrder = layoutOrder or 0}, page)
    local ToggleBtn = make("TextButton", {Size = UDim2.new(1, bindId and -50 or 0, 1, 0), BackgroundColor3 = enabled and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(25, 25, 32), Text = text .. (enabled and ": ВКЛ" or ": ВЫКЛ"), TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.GothamBold, TextSize = 12}, Row)
    addCorner(ToggleBtn, 6)
    
    local BindBtn = nil
    if bindId then
        BindBtn = make("TextButton", {Size = UDim2.new(0, 45, 1, 0), Position = UDim2.new(1, -45, 0, 0), BackgroundColor3 = Color3.fromRGB(35, 35, 45), Text = "None", TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.GothamBold, TextSize = 11}, Row)
        addCorner(BindBtn, 6)
        local k = binds[bindId]
        if k then BindBtn.Text = "["..k.."]" BindBtn.TextColor3 = Color3.fromRGB(150, 255, 150) end
    end

    local isLocalBinding = false

    local function SetState(state) 
        enabled = state 
        mySetts.toggles[text] = enabled
        saveData()
        
        ToggleBtn.Text = text .. (enabled and ": ВКЛ" or ": ВЫКЛ")
        tween(ToggleBtn, 0.2, {BackgroundColor3 = enabled and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(25, 25, 32)})
        callback(enabled) 
    end
    
    ToggleBtn.MouseButton1Click:Connect(function() SetState(not enabled) end)
    
    if BindBtn then
        BindBtn.MouseButton1Click:Connect(function() 
            isLocalBinding = true 
            BindBtn.Text = "..." 
            tween(BindBtn, 0.2, {TextColor3 = Color3.fromRGB(255, 200, 50)})
        end)
        UIS.InputBegan:Connect(function(input, gpe)
            if isLocalBinding and input.UserInputType == Enum.UserInputType.Keyboard then
                local keyName = input.KeyCode.Name
                if keyName == "Escape" or keyName == "Backspace" then 
                    binds[bindId] = nil 
                    BindBtn.Text = "None"
                    BindBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                else 
                    binds[bindId] = keyName 
                    BindBtn.Text = "["..keyName.."]"
                    BindBtn.TextColor3 = Color3.fromRGB(150, 255, 150)
                end
                isLocalBinding = false
                saveData()
            elseif not gpe and not isLocalBinding and binds[bindId] and input.KeyCode.Name == binds[bindId] then
                SetState(not enabled)
            end
        end)
    end
    
    task.spawn(function() callback(enabled) end)
    
    return SetState
end

