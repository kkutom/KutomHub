-- ESP с отображением здоровья
local espConnections = {}
local function updateEspForCharacter(p, char, enable)
    if not char then return end
    local hl = char:FindFirstChild("KutomHubESP")
    local bg = char:FindFirstChild("KutomHubHealthTag")

    if enable then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "KutomHubESP"
            hl.FillColor = Color3.fromRGB(0, 170, 255)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.Adornee = char
            hl.Parent = char
        end

        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if head and not bg then
            bg = Instance.new("BillboardGui")
            bg.Name = "KutomHubHealthTag"
            bg.Size = UDim2.new(0, 120, 0, 30)
            bg.StudsOffset = Vector3.new(0, 2.5, 0)
            bg.AlwaysOnTop = true
            bg.Parent = head

            local txt = Instance.new("TextLabel")
            txt.Name = "HealthText"
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 12
            txt.TextColor3 = Color3.fromRGB(0, 255, 100)
            txt.TextStrokeTransparency = 0.3
            txt.Parent = bg

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local function updateText()
                    txt.Text = string.format("%s\nHP: %d/%d", p.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))
                end
                updateText()
                espConnections[p] = hum.HealthChanged:Connect(function()
                    updateText()
                end)
            end
        end
    else
        if hl then hl:Destroy() end
        if bg then bg:Destroy() end
        if espConnections[p] then
            espConnections[p]:Disconnect()
            espConnections[p] = nil
        end
    end
end

createToggleRow("ESP (Wallhack + HP)", 350, function(state)
    espEnabled = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if espEnabled then
                if p.Character then updateEspForCharacter(p, p.Character, true) end
                p.CharacterAdded:Connect(function(newChar)
                    if espEnabled then
                        newChar:WaitForChild("HumanoidRootPart", 5)
                        updateEspForCharacter(p, newChar, true)
                    end
                end)
            else
                if p.Character then updateEspForCharacter(p, p.Character, false) end
            end
        end
    end
end)

