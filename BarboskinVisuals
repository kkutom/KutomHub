local isOpen = true
local isTweening = false

local function toggleHubVisibility()
    if isTweening then return end
    isTweening = true
    isOpen = not isOpen
    
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local targetPos = isOpen and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 1.5, 0)
    
    local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
    tween:Play()
    
    tween.Completed:Connect(function()
        isTweening = false
        if not isOpen then
            MainFrame.Visible = false
            FloatingBtn.Visible = true
        end
    end)

    if isOpen then
        FloatingBtn.Visible = false
        MainFrame.Visible = true
    end
end

MinimizeBtn.MouseButton1Click:Connect(toggleHubVisibility)
FloatingBtn.MouseButton1Click:Connect(toggleHubVisibility)

