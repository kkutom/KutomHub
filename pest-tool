    if not targetPlayerToSpam then return end
    loopKillActive = not loopKillActive
    if loopKillActive then
        LoopKillBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 90)
        LoopKillBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        LoopKillBtn.Text = "ВКЛ"
