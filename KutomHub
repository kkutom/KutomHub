-- Функция определения ролей
local function getRoleInfo(p)
    if mm2EarlyRoles[p.Name] then
        local r = mm2EarlyRoles[p.Name]
        if r == "Murderer" then return "MURDERER", Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" or r == "Hero" then return "SHERIFF", Color3.fromRGB(50, 150, 255) end
        return "Innocent", Color3.fromRGB(50, 255, 50)
    end
    local bp = p:FindFirstChild("Backpack") 
    local char = p.Character 
    local mur, sher = false, false
    local function c(f)
        if not f then return end
        for _, v in ipairs(f:GetChildren()) do 
            if v:IsA("Tool") then 
                if v.Name == "Knife" then mur = true end 
                if v.Name == "Gun" or v.Name == "Revolver" then sher = true end 
            end 
        end
    end
    c(bp) c(char)
    if mur then return "MURDERER", Color3.fromRGB(255, 50, 50) end
    if sher then return "SHERIFF", Color3.fromRGB(50, 150, 255) end
    return "Innocent", Color3.fromRGB(50, 255, 50)
end

-- ================== СИСТЕМА SILENT AIM (ПЕРЕХВАТ) ==================
local function getTargetForSilentAim(isMurderer)
    local target = nil
    local dist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local r = getRoleInfo(p)
            if isMurderer then
                local d = (p.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d; target = p.Character end
            else
                if r == "MURDERER" then return p.Character end
            end
        end
    end
    return target
end

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if isSilentAim and not checkcaller() then
            if tostring(self) == "ShootGun" and method == "InvokeServer" then
                local target = getTargetForSilentAim(false)
                if target and target:FindFirstChild("HumanoidRootPart") then
