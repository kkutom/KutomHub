local function preloadLocalMorphs()
    local files = {"druzhoktest.rbxm", "drujokledi.rbxm", "Zaichixa.rbxm", "eksursovod.rbxm", "podruzhka.rbxm", "sleppygena.rbxm"}
    local baseUrl = "https://raw.githubusercontent.com/kkutom/barboskinvisualscoolmorphs1488/main/"
    local ready = typeof(isfile) == "function" and typeof(readfile) == "function" and typeof(writefile) == "function"
        and typeof(isfolder) == "function" and typeof(makefolder) == "function"
    if ready then
        local ok = pcall(function() if not isfolder("Morphs") then makefolder("Morphs") end end)
        ready = ok
    end
    local function valid(data)
        return type(data) == "string" and #data > 32 and data:sub(1, 8) == "<roblox!"
    end
    for index, name in ipairs(files) do
        setLoadingStatus("Загрузка морфов: " .. name .. " (" .. index .. "/" .. #files .. ")")
        local path = "Morphs/" .. name
        local ok = false
        if ready then
            ok = pcall(function()
                local existing = isfile(path) and readfile(path)
                if valid(existing) then return end
                local requestFunction = (typeof(request) == "function" and request)
                    or (typeof(http_request) == "function" and http_request)
                    or (syn and typeof(syn.request) == "function" and syn.request)
                local body
                if requestFunction then
                    local response = requestFunction({Url = baseUrl .. name, Method = "GET"})
                    if not response or response.StatusCode ~= 200 then error("HTTP " .. tostring(response and response.StatusCode)) end
                    body = response.Body
                else
                    body = game:HttpGet(baseUrl .. name)
                end
                if not valid(body) then error("Некорректный файл модели") end
                writefile(path, body)
                if not isfile(path) or not valid(readfile(path)) then error("Файл не сохранился") end
            end)
        end
        if not ok then table.insert(morphLoadErrors, name) end
        setLoadingProgress(0.15 + 0.65 * index / #files)
        task.wait()
    end
end
