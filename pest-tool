ToolToggleBtn.MouseButton1Click:Connect(function()
    localPestAimActive = not localPestAimActive
    if localPestAimActive then
        ToolToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 90)
        ToolToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToolToggleBtn.Text = "ВКЛ"
