local function executeMiniCommand()
    local cmdText = MiniTextBox.Text
    if cmdText == "" then return end
    
    if string.sub(cmdText, 1, 1) ~= ";" then
        cmdText = ";" .. cmdText
    end

    pcall(function()
        local reqSignal = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if reqSignal then
            reqSignal = reqSignal:FindFirstChild("Signals")
            if reqSignal then
                reqSignal = reqSignal:FindFirstChild("RequestCommandSilent")
                if reqSignal and reqSignal:IsA("RemoteFunction") then
                    reqSignal:InvokeServer(cmdText)
                    showNotification("Выполнено: " .. cmdText, false)
                    return
                end
            end
        end
        showNotification("⚠️ Сигнал RequestCommandSilent не найден!", true)
    end)
end

