        Workspace:FindFirstChild("Livrason") and Workspace.Livrason:FindFirstChild("Location") and Workspace.Livrason.Location:FindFirstChild("3") and Workspace.Livrason.Location["3"]:FindFirstChild("ProximityPrompt"),
        Workspace:FindFirstChild("Livrason") and Workspace.Livrason:FindFirstChild("Location") and Workspace.Livrason.Location:FindFirstChild("4") and Workspace.Livrason.Location["4"]:FindFirstChild("ProximityPrompt"),
    }

    for _, prompt in ipairs(promptPaths) do
        pcall(function()
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt.HoldDuration = 0
            end
        end)
    end

    local function triggerPromptSafe(prompt)
        pcall(function()
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt:InputHoldBegin()
                task.wait(0.05)
                prompt:InputHoldEnd()
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                end
            end
        end)
    end

    local targetPartName = nil
    local hasBox = false

    pcall(function()
        local serviceEvent = ReplicatedStorage:FindFirstChild("Delivery System")
        if serviceEvent then
            serviceEvent = serviceEvent:FindFirstChild("Settings")
            if serviceEvent then
                serviceEvent = serviceEvent:FindFirstChild("ServiceEvent")
                if serviceEvent and serviceEvent:IsA("RemoteEvent") then
                    serviceEvent.OnClientEvent:Connect(function(action, eventType, digit)
                        if autoFarmEnabled then
                            if eventType == "Create" and digit then
                                targetPartName = tostring(digit)
                                hasBox = true
                            end
                        end
                    end)
                end
            end
        end
    end)

    while true do
        if autoFarmEnabled then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local rootPart = char.HumanoidRootPart
                    local humanoid = char.Humanoid
                    local takePart = Workspace:FindFirstChild("Livrason") and Workspace.Livrason:FindFirstChild("Take")

                    if takePart and not hasBox then
                        rootPart.CFrame = takePart.CFrame + Vector3.new(0, 3, 0)
                        rootPart.Velocity = Vector3.new(0, 0, 0)
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

                        local takePrompt = takePart:FindFirstChild("ProximityPrompt")
                        if takePrompt then
                            for i = 1, 3 do
                                triggerPromptSafe(takePrompt)
                                task.wait(0.15)
                            end
                            hasBox = true
                        end
                        task.wait(0.6)
                    end

                    if hasBox and targetPartName then
                        local locFolder = Workspace:FindFirstChild("Livrason") and Workspace.Livrason:FindFirstChild("Location")
                        if locFolder then
                            local targetLocPart = locFolder:FindFirstChild(targetPartName)
                            if targetLocPart then
                                rootPart.CFrame = targetLocPart.CFrame + Vector3.new(0, 3, 0)
                                rootPart.Velocity = Vector3.new(0, 0, 0)
                                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

                                local locPrompt = targetLocPart:FindFirstChild("ProximityPrompt")
                                if locPrompt then
                                    for i = 1, 3 do
                                        triggerPromptSafe(locPrompt)
                                        task.wait(0.15)
                                    end
                                end
                                task.wait(0.6)
                                
                                hasBox = false
                                targetPartName = nil
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)


