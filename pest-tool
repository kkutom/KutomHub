end)

local ToolObj = Instance.new("Tool")
ToolObj.Name = "Pest Tool"
ToolObj.RequiresHandle = true
ToolObj.CanBeDropped = false

local HandleObj = Instance.new("Part")
HandleObj.Name = "Handle"
HandleObj.Size = Vector3.new(1, 1, 3)
HandleObj.BrickColor = BrickColor.new("Bright red")
HandleObj.Material = Enum.Material.Neon
HandleObj.Parent = ToolObj

ToolObj.Equipped:Connect(function() ToolGui.Visible = true end)
ToolObj.Unequipped:Connect(function() ToolGui.Visible = false end)

ToolObj.Activated:Connect(function()
    if not localPestAimActive then return end
    local target = player:GetMouse().Target
    if target and target.Parent then
        local character = target.Parent
        local hum = character:FindFirstChildOfClass("Humanoid")
        if not hum and character.Parent and character.Parent:FindFirstChildOfClass("Humanoid") then
            character = character.Parent
        end
        local p = Players:GetPlayerFromCharacter(character)
        if p and p ~= player then
            targetPlayerToSpam = p
            ToolStatusLabel.Text = "Цель: " .. p.Name
        end
    end
end)

ToolObj.Parent = player.Backpack

task.spawn(function()
    while ToolObj and ToolObj.Parent do
        if (localPestAimActive or loopKillActive) and targetPlayerToSpam then
            local char = targetPlayerToSpam.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then
                    pcall(function()
                        local event = player.Backpack:FindFirstChild("Pistol") and player.Backpack.Pistol:FindFirstChild("RemoteEvent")
                        if not event and player.Character and player.Character:FindFirstChild("Pistol") then
                            event = player.Character.Pistol:FindFirstChild("RemoteEvent")
                        end
                        if event then event:FireServer(head) end
                    end)
                end
            end
        end
        task.wait(0.1)
    end
end)
