-- 1. Слушатель входящих сообщений чата (Board.Feed.OnClientEvent)
local function setupFeedChatListener()
    task.spawn(function()
        local board = ReplicatedStorage:WaitForChild("Board", 10)
        local feed = board and board:WaitForChild("Feed", 10)
        if feed and feed:IsA("RemoteEvent") then
            if _G.BarboskinFeedConn then
                pcall(function() _G.BarboskinFeedConn:Disconnect() end)
                _G.BarboskinFeedConn = nil
            end

            _G.BarboskinFeedConn = feed.OnClientEvent:Connect(function(...)
                local args = {...}
                local sender = args[1]
                local msg = args[2]

                local isFromMe = false
                if sender == player then
                    isFromMe = true
                elseif typeof(sender) == "Instance" and sender:IsA("Player") and sender.UserId == player.UserId then
                    isFromMe = true
                elseif typeof(sender) == "string" and (sender == player.Name or sender == player.DisplayName) then
                    isFromMe = true
                elseif args[2] == player or (typeof(args[2]) == "Instance" and args[2]:IsA("Player") and args[2].UserId == player.UserId) then
                    isFromMe = true
                    msg = args[1]
                elseif typeof(args[2]) == "string" and (args[2] == player.Name or args[2] == player.DisplayName) then
                    isFromMe = true
                    msg = args[1]
                end

                if isFromMe then
                    local cmdText = nil
                    if typeof(msg) == "string" then
                        local trimmed = string.match(msg, "^%s*(.*)")
                        if trimmed and string.sub(trimmed, 1, 1) == ";" then
                            cmdText = trimmed
                        end
                    end

                    if not cmdText then
                        for _, a in ipairs(args) do
                            if typeof(a) == "string" then
                                local trimmed = string.match(a, "^%s*(.*)")
                                if trimmed and string.sub(trimmed, 1, 1) == ";" then
                                    cmdText = trimmed
                                    break
                                end
                            end
                        end
                    end

                    if cmdText then
                        task.spawn(function()
                            executeHDCommand(cmdText, true)
                        end)
                    end
                end
            end)
        end
    end)
end
setupFeedChatListener()

-- 2. Фильтр отправляемых сообщений (перехват до отправки на сервер)
_G.BarboskinChatFilter = function(self, method, args)
    local m = string.lower(tostring(method))
    if m ~= "invokeserver" and m ~= "fireserver" then return false end

    local cmdFound = nil
    for _, arg in ipairs(args) do
        if typeof(arg) == "string" then
            local trimmed = string.match(arg, "^%s*(.*)")
            if trimmed and string.sub(trimmed, 1, 1) == ";" then
                cmdFound = trimmed
                break
            end
        elseif typeof(arg) == "table" then
            for _, val in pairs(arg) do
                if typeof(val) == "string" then
                    local trimmed = string.match(val, "^%s*(.*)")
                    if trimmed and string.sub(trimmed, 1, 1) == ";" then
                        cmdFound = trimmed
                        break
                    end
                end
            end
            if cmdFound then break end
        end
    end

    if cmdFound then
        task.spawn(function()
            executeHDCommand(cmdFound, true)
        end)
        -- Блокируем отправку в игру, чтобы другие игроки не видели команду
        return true
    end

    return false
end

if not _G.BarboskinChatHooked then
    _G.BarboskinChatHooked = true

    if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local selfName = tostring(self and self.Name)
            -- Не трогаем запросы к HD Admin
            if selfName == "RequestCommandSilent" then
                return oldNamecall(self, ...)
            end

            local method = getnamecallmethod()
            if _G.BarboskinChatFilter then
                local blocked = _G.BarboskinChatFilter(self, method, {...})
                if blocked then
                    return nil
                end
            end

            return oldNamecall(self, ...)
        end)
    end
end

local function runHeadCommands(firstCmd, secondCmd)
    task.spawn(function()
        pcall(function()
            local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
            if sigs then sigs = sigs:FindFirstChild("Signals") end
            if sigs then
                local req = sigs:FindFirstChild("RequestCommandSilent")
                if req and req:IsA("RemoteFunction") then
                    req:InvokeServer(firstCmd)
                    task.wait(1)
                    req:InvokeServer(secondCmd)
                    showNotification("VIP", "Голова применена!", false)
                end
            end
        end)
    end)
end

local function runHDSequence(commands, notifTitle, notifMsg, delaySec)
    local waitDelay = delaySec or 0.5
    task.spawn(function()
        pcall(function()
            local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
            if sigs then sigs = sigs:FindFirstChild("Signals") end
            if sigs then
                local req = sigs:FindFirstChild("RequestCommandSilent")
                if req and req:IsA("RemoteFunction") then
                    for i, cmd in ipairs(commands) do
                        req:InvokeServer(cmd)
                        if i < #commands then
                            task.wait(waitDelay)
                        end
                    end
                    if notifMsg then
                        showNotification(notifTitle or "Майнкрафт", notifMsg, false)
                    end
                end
            end
        end)
    end)
end

