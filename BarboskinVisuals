local function getCustomImage(url, fileName)
    if not url or url == "" then return "" end
    if not string.find(url, "^https?://") then return url end

    local customAsset = nil
    pcall(function()
        local rawName = fileName or string.match(url, "([^/]+)$") or "custom_img.jpg"
        rawName = string.match(rawName, "^([^%?]+)") or rawName
        local folder = "BarboskinVisuals_Cache"
        if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
            if not isfolder(folder) then makefolder(folder) end
            rawName = folder .. "/" .. rawName
        end

        local getAssetFunc = (typeof(getcustomasset) == "function" and getcustomasset)
            or (typeof(getsynasset) == "function" and getsynasset)

        if typeof(isfile) == "function" and isfile(rawName) then
            if getAssetFunc then
                customAsset = getAssetFunc(rawName)
            end
        elseif typeof(writefile) == "function" then
            local data = nil
            if typeof(game.HttpGet) == "function" then
                data = game:HttpGet(url)
            elseif typeof(request) == "function" then
                local resp = request({Url = url, Method = "GET"})
                data = resp and resp.Body
            elseif typeof(http_request) == "function" then
                local resp = http_request({Url = url, Method = "GET"})
                data = resp and resp.Body
            end

            if data and #data > 0 then
                writefile(rawName, data)
                if getAssetFunc then
                    customAsset = getAssetFunc(rawName)
                end
            end
        end
    end)
    return customAsset or url
end

