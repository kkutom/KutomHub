    cartButton.MouseButton1Click:Connect(openCart)
    local selected, cursor, keyword, generation, busy = nil, nil, "", 0, false
    local catalogPages = nil
    local HttpService = game:GetService("HttpService")
    local function searchPage(nextPage)
        if busy then return end
        if nextPage and not cursor then status.Text = "Больше результатов нет"; return end
        if not nextPage then
            keyword = search.Text:match("^%s*(.-)%s*$")
            if keyword == "" and creator.Text:match("^%s*$") then status.Text = "Введите название или автора"; return end
            cursor = nil
        end
        busy = true
        generation = generation + 1
        local currentGeneration = generation
        status.Text = kind == "head" and "Поиск голов..." or "Поиск аксессуаров..."
        task.spawn(function()
            -- Roblox выполняет поиск сам: прямой HTTP к catalog.roblox.com
            -- некоторые исполнители отклоняют с 403.
            local ok, data = pcall(function()
                if nextPage then
                    if not catalogPages or catalogPages.IsFinished then error("Больше результатов нет") end
                    catalogPages:AdvanceToNextPageAsync()
                else
                    local params = CatalogSearchParams.new()
                    params.SearchKeyword = keyword
                    params.CreatorName = creator.Text:match("^%s*(.-)%s*$")
                    params.Limit = 30
                    if kind == "head" then
                        params.BundleTypes = {Enum.BundleType.DynamicHead}
                    elseif kind == "shirt" then
                        params.AssetTypes = {Enum.AvatarAssetType.Shirt}
                    elseif kind == "pants" then
                        params.AssetTypes = {Enum.AvatarAssetType.Pants}
                    else
                        params.AssetTypes = {
                            Enum.AvatarAssetType.Hat, Enum.AvatarAssetType.HairAccessory,
                            Enum.AvatarAssetType.FaceAccessory, Enum.AvatarAssetType.NeckAccessory,
                            Enum.AvatarAssetType.ShoulderAccessory, Enum.AvatarAssetType.FrontAccessory,
                            Enum.AvatarAssetType.BackAccessory, Enum.AvatarAssetType.WaistAccessory
                        }
                    end
                    catalogPages = game:GetService("AvatarEditorService"):SearchCatalog(params)
                end
                local results = {}
                for _, item in ipairs(catalogPages:GetCurrentPage()) do
                    if item.Id then
                        table.insert(results, {
                            itemType = (kind == "head" and item.BundleType ~= nil) and "Bundle" or "Asset", kind = kind, id = item.Id, name = item.Name,
                            creatorName = item.CreatorName, price = item.Price,
                            description = item.Description
                        })
                    end
                end
                return {data = results, nextPageCursor = not catalogPages.IsFinished and "next" or nil}
            end)
            if not gui.Parent or currentGeneration ~= generation then return end
            busy = false
            if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
                status.Text = "Ошибка поиска: " .. tostring(data)
                return
            end
            for _, child in ipairs(list:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
            list.CanvasPosition = Vector2.new(0, 0)
            cursor = data.nextPageCursor
            local count = 0
            for _, item in ipairs(data.data) do
                if tonumber(item.id) then
                    count = count + 1
                    local row = button(list, tostring(item.name or "Аксессуар") .. "  •  " .. tostring(item.id), UDim2.new(), UDim2.new(1, -6, 0, 42))
                    row.LayoutOrder = count
                    row.MouseButton1Click:Connect(function()
                        selected = item.itemType == "Asset" and item or nil
                        preview.Image = "rbxthumb://type=" .. (item.itemType == "Bundle" and "BundleThumbnail" or "Asset") .. "&id=" .. tostring(item.id) .. "&w=150&h=150"
                        info.Text = tostring(item.name or "Аксессуар") .. "\nID: " .. tostring(item.id)
                            .. "\nАвтор: " .. tostring(item.creatorName or "неизвестен")
                            .. "\nЦена: " .. (item.price and tostring(item.price) .. " Robux" or "не указана")
                        description.Text = tostring(item.description or "Загрузка описания...")
                        if item.itemType == "Bundle" then
                            status.Text = "Поиск ID головы внутри комплекта..."
                            task.spawn(function()
                                local okBundle, bundle = pcall(function()
                                    return AssetService:GetBundleDetailsAsync(item.id)
                                end)
                                if not gui.Parent or info.Text:find(tostring(item.id), 1, true) == nil then return end
                                local headId
                                if okBundle and bundle then
                                    for _, entry in ipairs(bundle.Items or {}) do
                                        local assetType = entry.AssetType or entry.AssetTypeId
                                        local assetNumber = typeof(assetType) == "EnumItem" and assetType.Value or tonumber(assetType)
                                        if entry.Type == "Asset" and not assetNumber and entry.Id then
                                            local okInfo, assetInfo = pcall(function()
                                                return game:GetService("MarketplaceService"):GetProductInfo(entry.Id, Enum.InfoType.Asset)
                                            end)
                                            if okInfo and assetInfo then assetNumber = tonumber(assetInfo.AssetTypeId) end
                                        end
                                        if entry.Type == "Asset" and (assetNumber == 17 or assetNumber == 79) then
                                            headId = entry.Id
                                            break
                                        end
                                    end
                                end
                                if headId then
                                    selected = {id = headId, name = item.name, itemType = "Asset", kind = "head"}
                                    info.Text = tostring(item.name) .. "\nID головы: " .. tostring(headId)
                                        .. "\nКомплект: " .. tostring(item.id)
                                    description.Text = tostring(bundle.Description or item.description or "Описание отсутствует")
                                    status.Text = "Найден ID головы внутри комплекта"
                                else
                                    selected = nil
                                    status.Text = "В комплекте не найден ID головы; попробуйте другой"
                                    description.Text = tostring(item.description or "Описание отсутствует")
                                end
                            end)
                            return
                        end
                        task.spawn(function()
                            local detailOk, detail = pcall(function()
                                return game:GetService("MarketplaceService"):GetProductInfo(item.id, Enum.InfoType.Asset)
                            end)
                            if gui.Parent and selected == item then
                                if detailOk and detail then
                                    description.Text = detail.Description ~= "" and detail.Description or "Описание отсутствует"
                                    info.Text = tostring(detail.Name or item.name or "Аксессуар") .. "\nID: " .. tostring(item.id)
                                        .. "\nАвтор: " .. tostring(detail.Creator and detail.Creator.Name or item.creatorName or "неизвестен")
                                        .. "\nЦена: " .. (detail.PriceInRobux and tostring(detail.PriceInRobux) .. " Robux" or "не указана")
                                else
                                    description.Text = item.description or "Не удалось загрузить описание"
                                end
                            end
                        end)
                    end)
                end
            end
            status.Text = count > 0 and ("Найдено на странице: " .. count) or "Ничего не найдено; попробуйте другое название"
        end)
    end
    searchButton.MouseButton1Click:Connect(function() searchPage(false) end)
    search.FocusLost:Connect(function(enterPressed) if enterPressed then searchPage(false) end end)
    nextButton.MouseButton1Click:Connect(function() searchPage(true) end)
    addCart.MouseButton1Click:Connect(function()
        if not selected or not tonumber(selected.id) then status.Text = "Сначала выберите предмет"; return end
        for _, entry in ipairs(catalogCart) do
            if tostring(entry.id) == tostring(selected.id) and entry.kind == kind then
                status.Text = "Предмет уже в корзине"; return
