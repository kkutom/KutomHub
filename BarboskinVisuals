local saveFileName = "BarboskinVisuals_SaveData.json"
local savedEmotesTab = {}
local savedPacksTab = {}

local function saveData()
    pcall(function()
        local dataToSave = { emotes = {}, packs = {} }
        for _, em in ipairs(savedEmotesTab) do
            table.insert(dataToSave.emotes, {
                name = em.name,
                assetId = em.assetId,
                keybind = em.keybind and em.keybind.Name or nil
            })
        end
        for _, pk in ipairs(savedPacksTab) do
            table.insert(dataToSave.packs, {
                name = pk.name,
                bundleId = pk.bundleId
            })
        end
        if writefile then
            writefile(saveFileName, HttpService:JSONEncode(dataToSave))
        end
    end)
end

local function loadData()
    pcall(function()
        if readfile and isfile and isfile(saveFileName) then
            local raw = readfile(saveFileName)
            local data = HttpService:JSONDecode(raw)
            if data then
                if data.emotes then
                    for _, em in ipairs(data.emotes) do
                        table.insert(savedEmotesTab, {
                            name = em.name,
                            assetId = em.assetId,
                            keybind = em.keybind and Enum.KeyCode[em.keybind] or nil
                        })
                    end
                end
                if data.packs then
                    for _, pk in ipairs(data.packs) do
                        table.insert(savedPacksTab, {
                            name = pk.name,
                            bundleId = pk.bundleId
                        })
                    end
                end
            end
        end
    end)
end

loadData()

