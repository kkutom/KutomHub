    local function snipePlayer(targetName)
        showNotice("🔍 Поиск " .. targetName .. " (жди 10-20 сек)...")
        task.spawn(function()
            local success, targetId = pcall(function() return Players:GetUserIdFromNameAsync(targetName) end)
            if not success or not targetId then showNotice("⚠️ Игрок " .. targetName .. " не найден!") return end
            
            local reqFunc = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
            if not reqFunc then
                showNotice("⚠️ Твой экзекутор не поддерживает поиск (нужен HTTP Request)!")
                return
            end
            
            local thumbUrl = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="..targetId.."&size=150x150&format=Png&isCircular=false"
            local thumbRes
            pcall(function() thumbRes = Http:JSONDecode(game:HttpGet(thumbUrl)) end)
            
            if not thumbRes or not thumbRes.data or not thumbRes.data[1] then 
                showNotice("⚠️ Не удалось получить аватар игрока!") 
                return 
            end
            local targetImage = thumbRes.data[1].imageUrl

            local cursor = ""
            local foundServerId = nil
            
            for i = 1, 10 do
                if foundServerId then break end
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
                if cursor ~= "" then url = url .. "&cursor=" .. cursor end
                
                local res
                pcall(function() res = Http:JSONDecode(game:HttpGet(url)) end)
                if not res or not res.data then break end
                
                for _, server in ipairs(res.data) do
                    if type(server) == "table" and server.playerTokens and #server.playerTokens > 0 and server.playing < server.maxPlayers then
                        local reqBody = {}
                        for _, token in ipairs(server.playerTokens) do
                            table.insert(reqBody, {
                                requestId = token,
                                type = "AvatarHeadshot",
                                targetId = 0,
                                sessionId = "",
                                size = "150x150",
                                format = "png",
                                isCircular = false
                            })
                        end
                        
                        local thumbCheck
                        pcall(function()
                            local r = reqFunc({
                                Url = "https://thumbnails.roblox.com/v1/batch",
                                Method = "POST",
                                Headers = {["Content-Type"] = "application/json", ["Accept"] = "application/json"},
                                Body = Http:JSONEncode(reqBody)
                            })
                            thumbCheck = Http:JSONDecode(r.Body)
                        end)
                        
                        if thumbCheck and thumbCheck.data then
                            for _, tokenData in ipairs(thumbCheck.data) do
                                if tokenData.imageUrl == targetImage then
                                    foundServerId = server.id
                                    break
                                end
                            end
                        end
                    end
                    if foundServerId then break end
                end
                cursor = res.nextPageCursor
                if not cursor then break end
            end
            
            if foundServerId then
                showNotice("✅ Игрок найден! Подключаемся...")
                TPS:TeleportToPlaceInstance(game.PlaceId, foundServerId, player)
            else
                showNotice("❌ Игрок не найден на открытых серверах.")
            end
        end)
    end

