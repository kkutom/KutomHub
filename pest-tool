        ToolStatusLabel.TextColor3 = Color3.fromRGB(60, 180, 90)
    else
        ToolToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        ToolToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        ToolToggleBtn.Text = "ВЫКЛ"
        ToolStatusLabel.Text = "Статус: Выключено"
        ToolStatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        targetPlayerToSpam = nil
        loopKillActive = false
        LoopKillBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        LoopKillBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        LoopKillBtn.Text = "ВЫКЛ"
