-- Логика
local collecting = false

ToggleBtn.MouseButton1Click:Connect(function()
	collecting = not collecting
	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	
	if collecting then
		ToggleBtn.Text = "Авто-сбор: ВКЛ"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
	else
		ToggleBtn.Text = "Авто-сбор: ВЫКЛ"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		StatusLabel.Text = "Статус: Остановлено"
		-- Возвращаем управление при выключении
		if rootPart then rootPart.Anchored = false end
		if humanoid then humanoid.PlatformStand = false end
	end
end)

-- Фоновый поток сбора с фиксацией на месте
task.spawn(function()
	while ScreenGui.Parent do
		if collecting then
			local delayTime = tonumber(SpeedBox.Text) or 0.5
			local coinsFolder = Workspace:FindFirstChild("Манеты")
			
			if coinsFolder then
				local foundAny = false
				for _, coin in ipairs(coinsFolder:GetChildren()) do
					if not collecting then break end
					
					local char = LocalPlayer.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						local rootPart = char.HumanoidRootPart
						local humanoid = char:FindFirstChildOfClass("Humanoid")
						
						foundAny = true
						StatusLabel.Text = "Статус: Стоим в монете..."
						
						-- Телепортируемся к монете
						rootPart.CFrame = coin.CFrame + Vector3.new(0, 3, 0)
						
						-- Фиксируем персонажа, чтобы он не мог двигаться и падать
						rootPart.Anchored = true
						if humanoid then humanoid.PlatformStand = true end
						
						task.wait(delayTime)
						
						-- Снимаем фиксацию перед перемещением к следующей монете
						rootPart.Anchored = false
						if humanoid then humanoid.PlatformStand = false end
					end
				end
				
				if not foundAny then
					StatusLabel.Text = "Статус: Монеты не найдены / Ждем..."
					local char = LocalPlayer.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						char.HumanoidRootPart.Anchored = false
					end
				end
			else
				StatusLabel.Text = "Статус: Папка 'Манеты' не найдена!"
			end
		end
		task.wait(0.2)
	end
end)
