local function executeHDCommand(cmdText, isSilent)
    if not cmdText or cmdText == "" then return end
    if string.sub(cmdText, 1, 1) ~= ";" then
        cmdText = ";" .. cmdText
    end
    pcall(function()
        local reqSignal = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if reqSignal then
            reqSignal = reqSignal:FindFirstChild("Signals")
            if reqSignal then
                reqSignal = reqSignal:FindFirstChild("RequestCommandSilent")
                if reqSignal and reqSignal:IsA("RemoteFunction") then
                    reqSignal:InvokeServer(cmdText)
                    print("[BarboskinVisuals] Выполнена команда: " .. cmdText)
                    if not isSilent then
                        showNotification("HD Admin", "Выполнено: " .. cmdText, false)
                    end
                    return
                end
            end
        end
        if not isSilent then
            showNotification("HD Admin", "⚠️ Сигнал администратора не найден!", true)
        end
    end)
end

