-- Компактный автономный код: UTF-8 название в base64url, ID в base36.
local shareAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local function encodeShareText(value)
    local out, buffer, bits = {}, 0, 0
    for i = 1, #value do
        buffer = buffer * 256 + value:byte(i); bits = bits + 8
        while bits >= 6 do
            bits = bits - 6
            local n = math.floor(buffer / 2^bits)
            table.insert(out, shareAlphabet:sub(n + 1, n + 1))
            buffer = buffer % 2^bits
        end
    end
    if bits > 0 then local n = buffer * 2^(6-bits); table.insert(out, shareAlphabet:sub(n+1,n+1)) end
    return table.concat(out)
end
local function decodeShareText(value)
    local out, buffer, bits = {}, 0, 0
    for i = 1, #value do
        local n = shareAlphabet:find(value:sub(i,i), 1, true)
        if not n then return nil end
        buffer = buffer * 64 + n - 1; bits = bits + 6
        if bits >= 8 then
            bits = bits - 8
            table.insert(out, string.char(math.floor(buffer / 2^bits)))
            buffer = buffer % 2^bits
        end
    end
    if bits > 0 and buffer ~= 0 then return nil end
    return table.concat(out)
end
local function toBase36(n)
    local chars, result = "0123456789abcdefghijklmnopqrstuvwxyz", ""
    repeat local digit = n % 36; result = chars:sub(digit+1,digit+1) .. result; n = math.floor(n/36) until n == 0
    return result
end
local shareKinds = {accessory="a", head="h", shirt="s", pants="p"}
local shareKindsReverse = {a="accessory", h="head", s="shirt", p="pants"}
local function encodeSkinset(set)
    if type(set.name) ~= "string" or #set.name == 0 or #set.name > 200 or type(set.items) ~= "table" or #set.items == 0 or #set.items > 100 then return nil end
    local result = {"BV1", encodeShareText(set.name)}
    for _, item in ipairs(set.items) do
        local id = tostring(item.id or "")
        local number = tonumber(id)
        local kind = shareKinds[item.kind or "accessory"]
        if not kind or not id:match("^%d+$") or not number or number < 1 or number > 9007199254740991 then return nil end
        table.insert(result, kind .. toBase36(number))
    end
    return table.concat(result, ".")
end
local function decodeSkinset(code)
    if type(code) ~= "string" or #code > 4096 then return nil end
    code = code:match("^%s*(.-)%s*$")
    local fields = string.split(code, ".")
    if fields[1] ~= "BV1" or #fields < 3 or #fields > 102 then return nil end
    local name = decodeShareText(fields[2])
    if not name or #name == 0 or #name > 200 or not utf8.len(name) then return nil end
    local items = {}
    for i = 3, #fields do
        local kind = shareKindsReverse[fields[i]:sub(1,1)]
        local digits = fields[i]:sub(2)
        if not kind or not digits:match("^[0-9a-z]+$") or #digits > 11 then return nil end
        local id = tonumber(digits, 36)
        if not id or id < 1 or id > 9007199254740991 then return nil end
        table.insert(items, {kind=kind, id=string.format("%.0f", id), name="ID " .. string.format("%.0f", id)})
    end
    return {name=name, items=items}
end

