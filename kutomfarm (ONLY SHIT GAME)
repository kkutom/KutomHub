-- Логика фарма монет
local collecting = false

ToggleBtn.MouseButton1Click:Connect(function()
	collecting = not collecting
	if collecting then
		ToggleBtn.Text = "Авто-сбор: ВКЛ"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80) -- Зеленый
	else
		ToggleBtn.Text = "Авто-сбор: ВЫКЛ"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Красный
		StatusLabel.Text = "Статус: Остановлено"
	end
end)

-- Фоновый поток для сбора монет
task.spawn(function()
	while ScreenGui.Parent do
		if collecting then
			local delayTime = tonumber(SpeedBox.Text) or 0.5
			local coinsFolder = Workspace:FindFirstChild("Манеты")
			
			if coinsFolder then
				local foundAny = false
				for _, coin in ipairs(coinsFolder:GetChildren()) do
					if not collecting then break end
					
					if coin:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
						foundAny = true
						StatusLabel.Text = "Статус: Сбор монет..."
						LocalPlayer.Character.HumanoidRootPart.CFrame = coin.CFrame + Vector3.new(0, 3, 0)
						task.wait(delayTime)
					end
				end
				
				if not foundAny then
					StatusLabel.Text = "Статус: Монеты не найдены / Ждем..."
				end
			else
				StatusLabel.Text = "Статус: Папка 'Манеты' не найдена!"
			end
		end
		task.wait(0.2)
	end
end)
