    -- Вспомогательная функция для стандартных VIP морфов
    local function runStandardVIPMorph(bundleId, morphTitle, fixedAnimBundle, alwaysApplyAnimation)
        local morphAnimBundle = fixedAnimBundle or selectedMorphAnimBundle
        local isAlreadyMorphed = (_G.BarboskinIsMorphed == true)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            isAlreadyMorphed = false
            _G.BarboskinIsMorphed = false
            _G.BarboskinIsBird = false
        end

        if isAlreadyMorphed then
            -- БЫСТРАЯ СМЕНА МОРФА
            showHDHint("⚡ Смена морфа на: " .. morphTitle .. "...", Color3.fromRGB(255, 200, 60))
            task.spawn(function()
                pcall(function()
                    local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
                    if sigs then sigs = sigs:FindFirstChild("Signals") end
                    if sigs then
                        local req = sigs:FindFirstChild("RequestCommandSilent")
                        if req and req:IsA("RemoteFunction") then
                            req:InvokeServer(";clrhats")
                            task.wait(0.5)

                            -- Если до этого была птица/попугай, обязательно возвращаем нормальную выбранную анимацию
                            if alwaysApplyAnimation or _G.BarboskinIsBird or _G.BarboskinCurrentAnimBundle ~= morphAnimBundle then
                                req:InvokeServer(";bundle me " .. tostring(morphAnimBundle))
                                task.wait(0.5)
                                _G.BarboskinIsBird = false
                                _G.BarboskinCurrentAnimBundle = morphAnimBundle
                            end

                            req:InvokeServer(";bundle me " .. tostring(bundleId))
                            _G.BarboskinIsMorphed = true
                            showHDHint("✅ " .. morphTitle .. " надет!", Color3.fromRGB(85, 255, 85))
                        end
                    end
                end)
            end)
        else
            -- ПОЛНЫЙ ЦИКЛ ПРЕВРАЩЕНИЯ С НУЛЯ
            showHDHint("⏳ Превращение: " .. morphTitle .. "...", Color3.fromRGB(255, 200, 60))
            task.spawn(function()
                pcall(function()
                    local morphEvent = ReplicatedStorage:FindFirstChild("events")
                    if morphEvent then morphEvent = morphEvent:FindFirstChild("morphChange") end
                    if morphEvent and morphEvent:IsA("RemoteEvent") then
                        morphEvent:FireServer("Simple", "Bilder")
                    end
                end)
                task.wait(1)
                pcall(function()
                    local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
                    if sigs then sigs = sigs:FindFirstChild("Signals") end
                    if sigs then
                        local req = sigs:FindFirstChild("RequestCommandSilent")
                        if req and req:IsA("RemoteFunction") then
                            req:InvokeServer(";dinofy")
                            task.wait(1)
                            req:InvokeServer(";undinofy")
                            task.wait(1)
                            req:InvokeServer(";clrhats")
                            task.wait(1)
                            req:InvokeServer(";bundle me " .. tostring(morphAnimBundle))
                            task.wait(1)
                            req:InvokeServer(";bundle me " .. tostring(bundleId))
                            _G.BarboskinIsMorphed = true
                            _G.BarboskinIsBird = false
                            _G.BarboskinCurrentAnimBundle = morphAnimBundle
                            showHDHint("✅ " .. morphTitle .. " готов!", Color3.fromRGB(85, 255, 85))
                        end
                    end
                end)
            end)
        end
    end

