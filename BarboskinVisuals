-- Радужная пружина меняется только локально и восстанавливается при выключении.
if type(_G.BarboskinRainbowSpringCleanup) == "function" then
    pcall(_G.BarboskinRainbowSpringCleanup)
end
local springEnabled = false
local springOriginals = {}
local springConnection
local function restoreSpring()
    for mesh, original in pairs(springOriginals) do
        pcall(function()
            if mesh.Parent then mesh.TextureId = original.texture end
            if original.handle.Parent then original.handle.Color = original.color end
        end)
    end
    springOriginals = {}
end
local function setRainbowSpring(enabled)
    springEnabled = enabled
    if springConnection then springConnection:Disconnect(); springConnection = nil end
    if not enabled then restoreSpring(); return end
    local elapsed = 0
    springConnection = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        if elapsed < 0.05 then return end
        elapsed = 0
        local hue = (math.floor(os.clock() * 2) % 12) / 12
        local backpack = player:FindFirstChildOfClass("Backpack")
        for _, holder in pairs({backpack, player.Character}) do
            if holder then
                local tool = holder:FindFirstChild("Очень Крутое")
                local handle = tool and tool:IsA("Tool") and tool:FindFirstChild("Handle")
                local mesh = handle and handle:IsA("BasePart") and handle:FindFirstChild("Mesh")
                if mesh and mesh:IsA("SpecialMesh") then
                    if not springOriginals[mesh] then
                        springOriginals[mesh] = {texture = mesh.TextureId, color = handle.Color, handle = handle}
                    end
                    mesh.TextureId = ""
                    handle.Color = Color3.fromHSV(hue, 1, 1)
                end
            end
        end
    end)
end
_G.BarboskinRainbowSpringCleanup = function() setRainbowSpring(false) end

-- Независимые радужные эффекты для Bomb и Pistol.
if type(_G.BarboskinRainbowItemsCleanup) == "function" then
    pcall(_G.BarboskinRainbowItemsCleanup)
end
local rainbowItems = {}
local function setRainbowItem(kind, enabled)
    local old = rainbowItems[kind]
    if old then
        old.connection:Disconnect()
        for object, saved in pairs(old.originals) do
            pcall(function()
                if object.Parent then object[saved.property] = saved.texture end
                if saved.part.Parent then saved.part.Color = saved.color end
            end)
        end
        rainbowItems[kind] = nil
    end
    if not enabled then return end
    local state = {originals = {}}
    local elapsed = 0
    state.connection = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        if elapsed < 0.05 then return end
        elapsed = 0
        local backpack = player:FindFirstChildOfClass("Backpack")
        for _, holder in pairs({backpack, player.Character}) do
            local tool = holder and holder:FindFirstChild(kind)
            if tool and tool:IsA("Tool") then
                local part, object, property
                if kind == "Bomb" then
                    part = tool:FindFirstChild("Handle")
                    object = part and part:FindFirstChild("Mesh")
                    if object and object:IsA("SpecialMesh") then property = "TextureId" end
                elseif kind == "Pistol" then
                    part = tool:FindFirstChild("pistol")
                    if part and part:IsA("MeshPart") then object, property = part, "TextureID" end
                end
                if part and part:IsA("BasePart") and object and property then
                    if not state.originals[object] then
                        state.originals[object] = {texture = object[property], color = part.Color, part = part, property = property}
                    end
                    object[property] = ""
                    part.Color = Color3.fromHSV((math.floor(os.clock() * 2) % 12) / 12, 1, 1)
                end
            end
        end
    end)
    rainbowItems[kind] = state
end
_G.BarboskinRainbowItemsCleanup = function()
    setRainbowItem("Bomb", false)
    setRainbowItem("Pistol", false)
end

