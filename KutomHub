-- ================== UI HELPER И ФУНКЦИИ ==================
local function make(cls, props, parent)
    local obj = Instance.new(cls)
    for k, v in pairs(props) do obj[k] = v end
    if parent then obj.Parent = parent end return obj
end

local function addCorner(p, r) return make("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function addStroke(p, c, t) return make("UIStroke", {Color = c, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p) end
local function tween(obj, t, props) if obj and TS then TS:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play() end end

local function tpToPos(cf)
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = cf
    end
end

local isFly, fConn, bv, bg = false, nil, nil, nil
local function toggleFly()
    isFly = not isFly 
    local c = player.Character if not c then return end local hrp = c:FindFirstChild("HumanoidRootPart") if not hrp then return end
    if isFly then
        bv = make("BodyVelocity", {MaxForce = Vector3.new(9e9, 9e9, 9e9)}, hrp) bg = make("BodyGyro", {MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 10000}, hrp)
        local cam = workspace.CurrentCamera
        fConn = RS.RenderStepped:Connect(function()
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then isFly = false fConn:Disconnect() return end
            bg.CFrame = cam.CFrame local mv = Vector3.new()
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
            bv.Velocity = mv.Magnitude > 0 and mv.Unit * mySetts.flySpeed or Vector3.zero
        end)
    else 
        if fConn then fConn:Disconnect() end if bv then bv:Destroy() end if bg then bg:Destroy() end 
    end
end

