                notifGui.Parent = CoreGui
            end

            local card = Instance.new("Frame")
            card.Size = UDim2.new(0, 360, 0, 65)
            card.Position = UDim2.new(0.5, -180, 0, -80)
            card.AnchorPoint = Vector2.new(0.5, 0)
            card.BackgroundColor3 = isError and Color3.fromRGB(45, 18, 18) or Color3.fromRGB(20, 26, 22)
            card.BackgroundTransparency = 0.05
            card.BorderSizePixel = 0
            card.ZIndex = 9999
            card.Parent = notifGui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 10)
            corner.Parent = card

            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1.5
            stroke.Color = isError and Color3.fromRGB(240, 70, 70) or Color3.fromRGB(70, 220, 120)
