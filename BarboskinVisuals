local function showNotification(titleText, msgText, isError)
    titleText = titleText or (isError and "Error" or "System")
    msgText = tostring(msgText or "")

    -- 1. Нативное уведомление HD Admin через Signals.Error
    local nativeShown = false
    pcall(function()
        local hdClient = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        local sigs = hdClient and hdClient:FindFirstChild("Signals")
        local errSig = sigs and sigs:FindFirstChild("Error")
        if errSig and typeof(firesignal) == "function" then
            firesignal(errSig.OnClientEvent, {
                tostring(titleText),
                tostring(msgText)
            })
            nativeShown = true
        end
    end)

    if nativeShown then return end

    -- 2. Запасной вариант (собственное GUI уведомление)
    task.spawn(function()
        pcall(function()
            local notifGui = CoreGui:FindFirstChild("BarboskinNotificationGui")
