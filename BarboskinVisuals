        updateCartCount()
        status.Text = "Предмет добавлен в корзину"
    end)
    copy.MouseButton1Click:Connect(function()
        if not selected then status.Text = "Сначала выберите аксессуар"; return end
        if typeof(setclipboard) ~= "function" then status.Text = "Исполнитель не поддерживает setclipboard"; return end
        local ok = pcall(setclipboard, tostring(selected.id))
        status.Text = ok and "ID скопирован" or "Не удалось скопировать ID"
    end)
    wear.MouseButton1Click:Connect(function()
        if not selected then status.Text = "Сначала выберите аксессуар"; return end
        local id = tostring(selected.id)
        local signals = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        signals = signals and signals:FindFirstChild("Signals")
        local command = signals and signals:FindFirstChild("RequestCommandSilent")
        if not command or not command:IsA("RemoteFunction") then status.Text = "HD Admin недоступен"; return end
        local commandText = ((selected and selected.kind == "head" and ";head me ") or (selected and selected.kind == "shirt" and ";shirt me ") or (selected and selected.kind == "pants" and ";pants me ") or ";hat me ") .. id
        status.Text = "Отправка команды " .. commandText
        task.spawn(function()
            local ok, err = pcall(function() command:InvokeServer(commandText) end)
            if gui.Parent then status.Text = ok and "Команда отправлена; результат зависит от игры" or ("Ошибка команды: " .. tostring(err)) end
        end)
    end)
end

local function injectBarboskinVisuals()
    setLoadingStatus("Поиск интерфейса игры...")
    local mainGui = playerGui:WaitForChild("MainGui", 10)
    if not mainGui then return false end

    local mainFrame = mainGui:WaitForChild("mainFrame", 10)
    local localScript = mainGui:WaitForChild("LocalScript", 10)
    if not mainFrame or not localScript then return false end

    local leftScroll = mainFrame.Left.ScrollingFrame
    local rightScroll = mainFrame.Right.Frame.ScrollingFrame
    local pageLayout = rightScroll:WaitForChild("UIPageLayout", 10)
    if not leftScroll or not rightScroll or not pageLayout then return false end

    -- 1. Удаление ненужных вкладок: Повторы, Магазин, Что нового
    local unwantedTabs = {
        ["Повторы"] = "repeats",
        ["Магазин"] = "shop",
        ["Что нового?"] = "news"
    }

    for _, b in ipairs(leftScroll:GetChildren()) do
        if b:IsA("TextButton") and b:FindFirstChild("TextLabel") then
            local text = b.TextLabel.Text
            if unwantedTabs[text] then
                b:Destroy()
            end
        end
    end

    for _, pageName in pairs(unwantedTabs) do
        local pg = rightScroll:FindFirstChild(pageName)
        if pg then pg:Destroy() end
    end

    -- 2. Очистка старых версий кастомных вкладок
    local oldTabsToClean = {"vip_hub", "visuals_hub", "admin_hub", "anims_hub", "barboskinvisuals", "minecraft", "vip_morphs", "skinsets", "local_morphs"}
    for _, id in ipairs(oldTabsToClean) do
        local oldBtn = leftScroll:FindFirstChild("btn_" .. id)
        if oldBtn then oldBtn:Destroy() end
        local oldPage = rightScroll:FindFirstChild("tab_" .. id)
        if oldPage then oldPage:Destroy() end
    end

    -- 3. Настройка левой колонки
    pcall(function()
        leftScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        leftScroll.ScrollBarThickness = 3
    end)

    -- ================== СИСТЕМА СОХРАНЕНИЯ НАСТРОЕК ==================
    local SETTINGS_FILE = "BarboskinVisuals_Config.json"
    local savedSettings = {}

    local function loadSettings()
        if typeof(readfile) == "function" and typeof(isfile) == "function" then
            pcall(function()
                if isfile(SETTINGS_FILE) then
                    local data = readfile(SETTINGS_FILE)
                    local HttpService = game:GetService("HttpService")
                    savedSettings = HttpService:JSONDecode(data) or {}
                end
            end)
        end
    end

    local function saveSettings()
        if typeof(writefile) == "function" then
            pcall(function()
                local HttpService = game:GetService("HttpService")
                local data = HttpService:JSONEncode(savedSettings)
                writefile(SETTINGS_FILE, data)
            end)
        end
    end

    loadSettings()

    -- Конструктор вкладок
    local function createTab(tabName, tabId, headerColor)
        local btn = localScript.leftButton:Clone()
        btn.Name = "btn_" .. tabId
        btn.Parent = leftScroll
        btn.TextLabel.Text = tabName

        local pg = localScript.tab:Clone()
        pg.Name = "tab_" .. tabId
        pg.Parent = rightScroll
        pg.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pg.ScrollBarThickness = 4

        btn.MouseButton1Click:Connect(function()
            mainFrame.Top.Title.Text = string.format('Меню <font color="%s">(%s)</font>', headerColor, tabName)
            pageLayout:JumpTo(pg)
        end)

        return {
            page = pg,
            addTitle = function(text)
                local t = localScript.title:Clone()
                t.Text = text
                t.Parent = pg
                return t
            end,
            addButton = function(text, callback)
                local b = localScript.button:Clone()
                b.Parent = pg
                b.TextLabel.Text = text
                b.MouseButton1Click:Connect(callback)
                return b
            end,
            addImageButton = function(text, image, desc, callback)
                if localScript:FindFirstChild("imageButton") then
                    local b = localScript.imageButton:Clone()
                    b.Parent = pg
                    b.TextLabel.Text = text
                    if image and image ~= "" then
                        b.ImageLabel.Visible = true
                        task.spawn(function()
                            local resolved = getCustomImage(image)
                            pcall(function()
                                b.ImageLabel.Image = resolved
                            end)
                        end)
                    else
                        b.ImageLabel.Visible = false
                        b.TextLabel.Position = UDim2.new(0.05, 0, 0.5, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    end
                    if desc and desc ~= "" and b:FindFirstChild("desc") then
                        b.desc.Text = desc
                        b.desc.Visible = true
                        b.TextLabel.Position = UDim2.new(image and 0.155 or 0.05, 0, 0.39, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    else
                        if b:FindFirstChild("desc") then
                            b.desc:Destroy()
                        end
                        b.TextLabel.Position = UDim2.new(image and 0.155 or 0.05, 0, 0.5, 0)
                        b.TextLabel.AnchorPoint = Vector2.new(0, 0.5)
                    end
                    b.MouseButton1Click:Connect(callback)
                    return b
                else
                    local b = localScript.button:Clone()
                    b.Parent = pg
                    b.TextLabel.Text = text
                    b.MouseButton1Click:Connect(callback)
                    return b
                end
            end,
            addToggle = function(text, defaultState, callbackOn, callbackOff, settingKey)
                local key = settingKey or text
                local state = defaultState
                if savedSettings[key] ~= nil then
                    state = savedSettings[key]
                end

                local tog = localScript.toggle:Clone()
                tog.Parent = pg
                tog.TextLabel.Text = text
                tog:SetAttribute("enable", state)
                tog.status.Text = state and "Вкл." or "Выкл."
                tog.status.TextColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

                local function applyState(nxt)
                    tog:SetAttribute("enable", nxt)
                    tog.status.Text = nxt and "Вкл." or "Выкл."
                    tog.status.TextColor3 = nxt and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                    savedSettings[key] = nxt
                    saveSettings()
                    if nxt then
                        if callbackOn then callbackOn() end
                    else
                        if callbackOff then callbackOff() end
                    end
                end

                tog.MouseButton1Click:Connect(function()
                    local cur = tog:GetAttribute("enable") == true
                    applyState(not cur)
                end)

                -- Автоматическое включение при входе, если было сохранено состояние true
                if state == true then
                    task.spawn(function()
                        task.wait(1.5)
                        if callbackOn then
                            pcall(callbackOn)
                        end
                    end)
                end

                return tog
            end,
            addTextBox = function(placeholder, onFocusLost)
                local boxFrame = localScript.textbox:Clone()
                boxFrame.Parent = pg
                boxFrame.TextBox.Text = ""
                boxFrame.TextBox.PlaceholderText = placeholder
                boxFrame.TextBox.ClearTextOnFocus = false
                boxFrame.TextBox.FocusLost:Connect(function(enter)
                    onFocusLost(enter, boxFrame.TextBox.Text)
                end)
                return boxFrame.TextBox
            end,
            addText = function(text)
                local t = localScript.text:Clone()
                t.Parent = pg
                t.TextLabel.Text = text
                return t.TextLabel
            end,
            addComment = function(text)
                local t = localScript.text:Clone()
                t.Parent = pg
                t.TextLabel.Text = text
                t.TextLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
                return t.TextLabel
            end
        }
    end

    -- Отслеживание надетого морфа и респавна персонажа
    _G.BarboskinIsMorphed = _G.BarboskinIsMorphed or false
    _G.BarboskinIsBird = _G.BarboskinIsBird or false
    _G.BarboskinCurrentAnimBundle = _G.BarboskinCurrentAnimBundle or nil

    if not _G.BarboskinRespawnTracked then
        _G.BarboskinRespawnTracked = true
        local function setupChar(char)
            _G.BarboskinIsMorphed = false
            _G.BarboskinIsBird = false
            _G.BarboskinCurrentAnimBundle = nil
            _G.BarboskinActiveLocalMorph = nil
            local hum = char:WaitForChild("Humanoid", 10)
            if hum then
                hum.Died:Connect(function()
                    _G.BarboskinIsMorphed = false
                    _G.BarboskinIsBird = false
                    _G.BarboskinCurrentAnimBundle = nil
                    _G.BarboskinActiveLocalMorph = nil
                end)
            end
        end
        if player.Character then setupChar(player.Character) end
        player.CharacterAdded:Connect(setupChar)
    end

    -- Переменные выбранной анимации для VIP морфов
    local selectedMorphAnimBundle = "43"
    local selectedMorphAnimName = "Toy Animation"

    -- Вспомогательная функция для стандартных VIP морфов
    local function runStandardVIPMorph(bundleId, morphTitle, fixedAnimBundle, alwaysApplyAnimation)
        local morphAnimBundle = fixedAnimBundle or selectedMorphAnimBundle
        local isAlreadyMorphed = (_G.BarboskinIsMorphed == true)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            isAlreadyMorphed = false
            _G.BarboskinIsMorphed = false
            _G.BarboskinIsBird = false
        end

        if isAlreadyMorphed then
            -- БЫСТРАЯ СМЕНА МОРФА
            showHDHint("⚡ Смена морфа на: " .. morphTitle .. "...", Color3.fromRGB(255, 200, 60))
            task.spawn(function()
                pcall(function()
                    local sigs = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
                    if sigs then sigs = sigs:FindFirstChild("Signals") end
                    if sigs then
                        local req = sigs:FindFirstChild("RequestCommandSilent")
                        if req and req:IsA("RemoteFunction") then
                            req:InvokeServer(";clrhats")
